# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real keys.

# "openai" (default, works with any OpenAI-compatible endpoint) or "anthropic"
PROVIDER=openai

API_KEY=

# Optional. Only needed to point an OpenAI-compatible provider (OpenRouter,
# DeepSeek, a local proxy, etc.) somewhere other than api.openai.com, or
# Anthropic somewhere other than api.anthropic.com.
BASE_URL=

# Optional. Defaults to deepseek/deepseek-v4-flash (openai) or
# claude-opus-4-6-20260101 (anthropic) if left unset.
MODEL=
